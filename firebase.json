{
  "hosting": {
    "site": "ncertbook",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.firebaserc",
      "**/.git/**",
      "**/.gitignore",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "**/*.bat",
      "**/*.cmd",
      "**/*.exe",
      "**/*.py",
      "**/*.pyc",
      "**/*.log",
      "Class_10/**",
      "all_ncert_books.json",
      "class10_books.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
